{
    "deploy": {
        "steps": [
            {
                "apply": {
                    "file": "data/vreplicaset-controller/v0/crd.yaml"
                }
            },
            {
                "apply": {
                    "file": "data/vdeployment-controller/v0/crd.yaml"
                }
            },
            {
                "apply": {
                    "file": "data/vdeployment-controller/v0/deploy_remote.yaml",
                    "namespace": null
                }
            },
            {
                "apply": {
                    "file": "data/anvil-rabbitmq-controller/crd.yaml"
                }
            },
            {
                "apply": {
                    "file": "data/anvil-rabbitmq-controller/vstatefulset_crd.yaml"
                }
            },
            {
                "apply": {
                    "file": "data/anvil-rabbitmq-controller/deploy_remote.yaml",
                    "operator": true
                }
            }
        ]
    },
    "crd_name": "rabbitmqclusters.anvil.dev",
    "seed_custom_resource": "data/anvil-rabbitmq-controller/cr.yaml",
    "kubernetes_version": "v1.30.0",
    "wait_time": 120,
    "example_dir": "data/anvil-rabbitmq-controller/examples",
    "custom_oracle": "data.anvil-rabbitmq-controller.oracle",
    "diff_ignore_fields": [
        "\\[\\'metadata\\'\\]\\[\\'annotations\\'\\]\\[\\'config\\'\\]",
        "\\['metadata'\\]\\['annotations'\\]\\['anvil\\.dev\\\/lastRestartAt'\\]"
    ]
}
