{
    "deploy": {
        "steps": [
            {
                "apply": {
                    "file": "data/rabbitmq-operator/v2-19-2/operator.yaml",
                    "operator": true
                }
            }
        ]
    },
    "crd_name": "rabbitmqclusters.rabbitmq.com",
    "seed_custom_resource": "data/rabbitmq-operator/v2-19-2/cr.yaml",
    "kubernetes_version": "v1.30.0",
    "wait_time": 120,
    "diff_ignore_fields": [
        "\\['metadata'\\]\\['annotations'\\]\\['rabbitmq.com",
        "\\['secret'\\]\\['default\\-token\\-.*'\\]",
        "\\['secret'\\]\\['rabbitmq\\-cluster\\-operator\\-token\\-.*'\\]",
        "\\['secret'\\]\\['test\\-cluster\\-server\\-token\\-.*'\\]",
        "\\['service'\\]\\['test\\-cluster'\\]\\['spec'\\]\\['ports'\\]"
    ]
}
